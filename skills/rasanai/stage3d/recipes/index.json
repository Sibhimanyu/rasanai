{
  "schema_version": 1,
  "recipes": [
    {
      "id": "character-handoff",
      "label": "Character pose and emotion handoff",
      "summary": "A crew character walks to its mark and hands the beat from look to an emotion; refuses, loudly, anything that cannot be rigged.",
      "params": {
        "durationS": {
          "type": "number",
          "min": 2,
          "max": 10,
          "default": 4
        },
        "fromX": {
          "type": "number",
          "min": -3,
          "max": 3,
          "default": -0.8
        },
        "toX": {
          "type": "number",
          "min": -3,
          "max": 3,
          "default": 0.4
        },
        "walkS": {
          "type": "number",
          "min": 0.4,
          "max": 4,
          "default": 1.6
        },
        "handoffAt": {
          "type": "number",
          "min": 0.5,
          "max": 9,
          "default": 2.2
        },
        "emotion": {
          "type": "enum",
          "enum": [
            "surprised",
            "joyful",
            "worried",
            "proud",
            "sad",
            "curious"
          ],
          "default": "joyful"
        },
        "then": {
          "type": "enum",
          "enum": [
            "none",
            "point",
            "hop",
            "look"
          ],
          "default": "none"
        },
        "emotionS": {
          "type": "number",
          "min": 0.4,
          "max": 4,
          "default": 1.4
        },
        "fps": {
          "type": "number",
          "min": 24,
          "max": 60,
          "default": 30
        }
      },
      "requires": [
        "identity (identity.json of a 3d-rig, rig.kind code)",
        "character-rig.js loaded"
      ],
      "seek_safe": true,
      "file": "character-handoff.js"
    },
    {
      "id": "focus-pull",
      "label": "Frame-correct focus pull",
      "summary": "A rack focus that is in focus on exactly the supplied event frame.",
      "params": {
        "eventS": {
          "type": "number",
          "min": 0.2,
          "max": 60,
          "default": 2
        },
        "pullS": {
          "type": "number",
          "min": 0.1,
          "max": 3,
          "default": 0.7
        },
        "fromDistance": {
          "type": "number",
          "min": 0.2,
          "max": 100,
          "default": 4
        },
        "toDistance": {
          "type": "number",
          "min": 0.2,
          "max": 100,
          "default": 9
        },
        "fstop": {
          "type": "number",
          "min": 1.2,
          "max": 8,
          "default": 2
        },
        "fps": {
          "type": "number",
          "min": 24,
          "max": 60,
          "default": 30
        }
      },
      "requires": [],
      "seek_safe": true,
      "file": "focus-pull.js"
    },
    {
      "id": "hero-turntable",
      "label": "Hero object turntable",
      "summary": "Turns the hero object, eases to rest on its hero yaw and settles the camera on-axis; materials kept, budget enforced.",
      "params": {
        "durationS": {
          "type": "number",
          "min": 2,
          "max": 12,
          "default": 6
        },
        "holdS": {
          "type": "number",
          "min": 0.4,
          "max": 3,
          "default": 1.2
        },
        "turns": {
          "type": "number",
          "min": 0.25,
          "max": 3,
          "default": 1
        },
        "heroYawDeg": {
          "type": "number",
          "min": -45,
          "max": 45,
          "default": 0
        },
        "startPitchDeg": {
          "type": "number",
          "min": 0,
          "max": 30,
          "default": 12
        },
        "endPitchDeg": {
          "type": "number",
          "min": -10,
          "max": 30,
          "default": 0
        },
        "lensMm": {
          "type": "number",
          "min": 35,
          "max": 135,
          "default": 70
        },
        "fill": {
          "type": "number",
          "min": 0.3,
          "max": 0.8,
          "default": 0.55
        },
        "objectSize": {
          "type": "number",
          "min": 0.2,
          "max": 3,
          "default": 1
        },
        "materialKind": {
          "type": "enum",
          "enum": [
            "keep",
            "glass",
            "frosted-glass",
            "chrome",
            "brushed-metal",
            "clay",
            "ceramic",
            "gummy",
            "plastic",
            "concrete",
            "paper",
            "matte"
          ],
          "default": "keep"
        },
        "budgetTriangles": {
          "type": "number",
          "min": 1000,
          "max": 2000000,
          "default": 300000
        },
        "budgetMaterials": {
          "type": "number",
          "min": 1,
          "max": 32,
          "default": 8
        },
        "budgetMode": {
          "type": "enum",
          "enum": [
            "throw",
            "warn"
          ],
          "default": "throw"
        },
        "fps": {
          "type": "number",
          "min": 24,
          "max": 60,
          "default": 30
        },
        "model": {
          "type": "string",
          "local_asset": true,
          "default": ""
        }
      },
      "requires": [
        "object or model (.glb)"
      ],
      "seek_safe": true,
      "file": "hero-turntable.js"
    },
