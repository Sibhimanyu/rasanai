    "glide": "cubic-bezier(0.2,0,0,1)",
    "expressive": "cubic-bezier(0.4,0.14,0.3,1)",
    "exit": "expo.in",
    "settle": "spring(0.68,12)",
    "snap": "expo.out",
    "drift": "sine.inOut",
    "move": "expo.inOut"
