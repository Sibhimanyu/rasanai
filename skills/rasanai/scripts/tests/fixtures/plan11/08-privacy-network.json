{
  "synthetic": true,
  "status": "implemented_unvalidated",
  "authored_not_run": true,
  "id": "plan11/R08",
  "case": "redaction, cache scope and URL ingestion policy",
  "targets": [
    "lib/redact.mjs",
    "lib/containment.mjs checkUrl / checkRedirect / forwardHeaders / resolveAndCheck / guardedFetch"
  ],
  "redaction": {
    "input": [
      "Authorization: Bearer sk-test-FAKE000000000000000000",
      "api_key=AIzaFAKEFAKEFAKEFAKEFAKE1",
