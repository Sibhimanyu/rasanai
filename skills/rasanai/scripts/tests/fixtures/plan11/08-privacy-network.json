      "https://cdn.example.invalid/a.mp4?token=abcdef0123456789",
      "/Users/someone/Clients/Acme/footage/day1.mov",
      "token budget: 12000 tokens (must NOT be redacted)"
    ],
    "expect": "each secret and personal path replaced; the last line unchanged; exportSafe leaks_after is 0; a value marked sensitive:true is replaced by its digest"
  },
  "cache": {
    "cases": [
      "same prompt in project A and project B",
      "same prompt, user scope vs shared scope"
    ],
    "expect": "scopedCacheKey differs; no key or summary contains a project name or path"
  },
