  "node $SKILL_DIR/scripts/console.mjs activity --run \"$RUN\" --message \"<what you're doing, plain words>\"",
  "node $SKILL_DIR/scripts/console.mjs reply --run \"$RUN\" --step <step> --message \"<one to three sentences>\"",
