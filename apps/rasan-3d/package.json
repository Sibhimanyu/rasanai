{
  "name": "rasan-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "vite",
    "build:studio": "vite build",
    "remotion": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts RasanDemo out/rasan-demo.mp4 --gl=angle --concurrency=4",
    "render:portrait": "remotion render src/remotion/index.ts RasanDemoPortrait out/rasan-demo-portrait.mp4 --gl=angle --concurrency=4",
    "render:frames": "remotion render src/remotion/index.ts RasanDemo out/frames --sequence --image-format=png --gl=angle --concurrency=4",
    "render:alpha": "remotion render src/remotion/index.ts RasanDemoAlpha out/alpha --sequence --image-format=png --gl=angle --concurrency=4",
    "render:still": "remotion still src/remotion/index.ts RasanDemo out/still.png --gl=angle",
    "shot": "node scripts/shot.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.1",
    "@remotion/cli": "^4.0.537",
    "@remotion/three": "^4.0.537",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.537",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
